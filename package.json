{
  "name": "adaptive-debugging-mcp",
  "version": "0.1.0",
  "description": "Adaptive Debugging Intelligence MCP for OpenCode CLI: persistent debugging memory, nested experiment trees, evidence-backed outcomes, and verified resolution.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "adaptive-debugging-mcp": "src/server/index.ts"
  },
  "scripts": {
    "start": "bun run src/server/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:evaluation": "bun test tests/evaluation",
    "eval": "bun test tests/evaluation/scenarios.test.ts",
    "smoke": "bun run tests/smoke/stdio-smoke.ts",
    "plugin-smoke": "bun run tests/smoke/plugin-smoke.ts",
    "obs-check": "bun run tests/smoke/obs-check.ts",
    "db:backup": "bun run src/cli/backup.ts backup",
    "db:verify": "bun run src/cli/backup.ts verify",
    "db:restore": "bun run src/cli/backup.ts restore",
    "db:prune": "bun run src/cli/backup.ts prune",
    "db:dashboard": "bun run src/cli/dashboard.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/bun": "^1.1.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.27"
  }
}
